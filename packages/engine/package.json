{
  "name": "vault-engine",
  "version": "0.1.0",
  "description": "Database-authoritative knowledge graph engine for markdown vaults",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vault-analyzer": "dist/analyzer/cli.js"
  },
  "scripts": {
    "build": "tsc && node ../../scripts/embedder-worker-provenance.mjs write ../.. && npm run typecheck && npm run build:ui",
    "build:ui": "tsc --noEmit -p tsconfig.ui.json && vite build --config vite.ui.config.ts",
    "typecheck": "tsc --project tsconfig.test.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:model": "vitest run --config vitest.model.config.ts",
    "test:watch": "vitest",
    "start:http": "node dist/index.js --transport http",
    "test:perf": "vitest run tests/perf/ --config vitest.perf.config.ts",
    "bench:search": "npm run build && tsx scripts/bench-search.ts",
    "eval:consolidation": "tsx scripts/eval-consolidation.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@deepgram/sdk": "^5.0.0",
    "@google/genai": "^1.50.1",
    "@huggingface/transformers": "^4.0.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vault/contract": "^0.1.0",
    "@vault/llm": "^0.1.0",
    "@vault/pricing": "^0.1.0",
    "@vault/settings-registry": "^0.1.0",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^5.0.0",
    "chrono-node": "^2.9.0",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ipaddr.js": "^1.9.1",
    "mammoth": "^1.12.0",
    "nanoid": "^5.1.7",
    "officeparser": "^6.0.7",
    "openai": "^6.42.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sqlite-vec": "^0.1.9",
    "typescript": "^6.0.2",
    "undici": "^7.30.2",
    "unified": "^11.0.5",
    "unpdf": "^1.4.0",
    "vitest": "^4.1.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.0",
    "@vault/query-core": "^0.1.0",
    "@vault/viz-ui": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "vite": "^6.4.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
