# HTTP transport only (stdio needs neither); Engine refuses to start HTTP without both.
# The password gates the OAuth authorization page: use a long random value, for example
# `openssl rand -base64 32`. The issuer is the public HTTPS URL clients reach Engine at
# (http is accepted only for localhost), for example https://vault.example.com
OAUTH_OWNER_PASSWORD=
OAUTH_ISSUER_URL=
# Folder (relative to the vault root) holding the settings notes
# (Settings/Engine/, Settings/Wiki.md, ...). Read at every boot — this is
# bootstrap config, not a migrated setting (it can't describe its own
# location). Default: Settings
# VAULT_SETTINGS_DIR=Settings
# Frontmatter key that holds a note's types (type: meeting, kind: meeting...).
# Bootstrap config, chosen at install: Engine records the key its database was
# built with and refuses to start with another. Default: types
# VAULT_TYPE_KEY=types
# Absolute folder for the embedder's model cache (hundreds of MB). Bootstrap
# config. Set it to keep the model files out of a vault in a sync folder
# (Dropbox, iCloud, Syncthing...). Default: <vault>/.vault-engine/models
# EMBEDDER_MODELS_DIR=/var/lib/vault-engine/models
# Attachment extraction (audio, image and scanned-PDF vision) uses these keys
# unless the extractionEnabled setting (seeded by EXTRACTION_ENABLED below) is off.
# Transcription. Add the usage:read and billing:read scopes so the daily job can confirm Deepgram's real charges.
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
# Model provider keys. The visionModel and memoryConsolidationModel settings
# name Settings/Models catalog entries on any of these providers, and each call
# needs the key of the provider its entry names. Under the "model" vision
# provider, scanned PDFs go to the visionModel when its provider takes PDF input
# (Anthropic, OpenAI) and to Gemini (GEMINI_API_KEY) otherwise. Memory
# consolidation runs when any of these keys is set. ANTHROPIC_API_KEY also
# serves the "claude" vision provider.
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Web search (web-search MCP tool). Absent → web-search disabled; fetch-url stays available.
EXA_API_KEY=

# ── MIGRATED TO SETTINGS NOTES (seed-only) ─────────────────────────────
# These are read ONCE to seed the Engine settings on first boot, then ignored.
# Edit the notes in Settings/Engine/ in the vault instead. A boot warning names any of
# these still set. New env var:
# VAULT_SETTINGS_DIR=Settings   # folder holding the settings notes
#
# VAULT_EXCLUDE_DIRS=
# VAULT_BACKUP_DISABLED=
# VAULT_BACKUP_INTERVAL_HOURS=24
# VAULT_BACKUP_KEEP=7
# EDITS_LOG_RETENTION_DAYS=90
# EXTRACTION_CACHE_RETENTION_DAYS=30
# SYNC_LOG_RETENTION_HOURS=24
# UNDO_RETENTION_HOURS=24
# NORMALIZE_CRON=
# NORMALIZE_QUIESCENCE_MINUTES=60
# EXTRACTION_ENABLED=true    # false: paid audio and vision extraction off; keys stay for other features
# VISION_PROVIDER=gemini     # gemini | claude | model (legacy value "qwen" seeds as "model")
#
# visionModel/memoryConsolidationModel are model-ref settings (Phase 3):
# seed the raw provider id below once, then the engine's one-shot models
# migration creates a Settings/Models/ catalog note for it and rewrites the
# stored value to a "[[Model Note Title]]" reference — edit the catalog note
# (or the reference in Settings/Engine/Models.md) afterward, never a raw id again.
# QWEN_VISION_MODEL seeds the visionModel key (env var name kept for back-compat).
# QWEN_VISION_MODEL=accounts/fireworks/models/qwen3p7-plus
# MEMORY_CONSOLIDATION_MODEL=accounts/fireworks/models/qwen3p7-plus
