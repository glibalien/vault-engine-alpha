# Copy to .env and fill in. Loaded via dotenv at startup.

# vault-engine MCP endpoint (no trailing /mcp — appended automatically)
ENGINE_URL=http://localhost:3334

# Long-lived bearer service token, minted in the vault-engine repo:
#   VAULT_PATH=/path/to/vault \
#     npx tsx scripts/issue-service-token.ts --name vault-curator
ENGINE_TOKEN=

# --- LLM provider keys ---
# Every key is optional — set whichever provider(s) the models you
# reference in Settings/Curator/Models.md and Settings/Models/ actually need. Each
# model note in Settings/Models/ pins its own provider (anthropic, fireworks,
# openrouter, or openai); the curator routes each call per-model, so a single process
# can mix providers. At least one key must be set for any synthesis call to
# succeed.
# Anthropic API key (needed for any Settings/Models/ entry with provider: anthropic)
ANTHROPIC_API_KEY=
# Fireworks API key (needed for any entry with provider: fireworks). Same variable
# the Engine reads. The original name OPENAI_COMPAT_API_KEY still works and wins
# when both are set.
# FIREWORKS_API_KEY=
# Fireworks base URL override (default: Fireworks serverless)
# OPENAI_COMPAT_BASE_URL=https://api.fireworks.ai/inference/v1
# OpenRouter API key (needed for any Settings/Models/ entry with provider: openrouter;
# fixed base URL https://openrouter.ai/api/v1, no Fireworks-specific request extensions)
# OPENROUTER_API_KEY=
# OpenAI API key (needed for any Settings/Models/ entry with provider: openai)
# OPENAI_API_KEY=

# --- curator MCP server (step 2 foundation) ---
# Owner password gating the OAuth authorize form (required only when running the server)
OAUTH_OWNER_PASSWORD=
# Public issuer URL behind the Cloudflare tunnel; HTTPS unless localhost (required only when running the server)
OAUTH_ISSUER_URL=
# Port for the curator's MCP server (distinct from the engine's 3334)
CURATOR_PORT=3335
# Curator SQLite DB (OAuth tables now; runs table in step 7). Defaults to <repo>/.state/curator.db
CURATOR_DB_PATH=

# Benchmark labels (optional): stamped onto every usage event this process
# reports to the engine spend ledger (record-usage). Also settable per-run
# via the CLI: --experiment / --variant.
# CURATOR_EXPERIMENT=curator-bench-2026-07
# CURATOR_VARIANT=deepseek-v4-pro

# One-shot backfill: overrides the stored memory-sweep watermark (ISO timestamp).
# Unset after use. STAYS env (not migrated — deliberate one-off, not a standing setting).
#CURATOR_MEMORY_SWEEP_SINCE=

# One-shot backfill: overrides the stored conversation-sweep watermark (ISO
# timestamp). Unset after use. STAYS env (not migrated — deliberate one-off,
# not a standing setting).
#
# IMPORTANT for dry runs: a cold start (no watermark yet, first run since
# enabling) initializes the watermark to "now", which makes the sweep's
# candidate window structurally empty — every dry run reports 0 scanned,
# 0 would-write, forever, until a real (non-dry) run seeds the watermark.
# To get a MEANINGFUL dry run, set this to a past ISO timestamp (e.g. 7 days
# ago) so the funnel has settled conversations to find.
#CURATOR_CONVERSATION_SWEEP_SINCE=

# ── MIGRATED TO SETTINGS NOTES (seed-only) ─────────────────────────────
# Read ONCE to seed the Curator settings on this service's first boot against a
# Phase-2 engine, then ignored. Edit the notes in Settings/Curator/ in the vault instead.
# A boot warning names any of these still set.

# Home/page-creation synthesis model — a Settings/Models/ catalog reference
# ([[Model Note Title]]). Provider is derived from the referenced entry.
# CURATOR_MODEL=
# Model used to infer AI-guessable fields. Raw provider IDs are canonicalized
# to their Settings/Models/ reference during the one-time seed.
# CURATOR_FIELD_GUESS_MODEL=[[GPT-OSS 120B]]
# Maximum field-guess model calls per full sweep; 0 disables the phase.
# CURATOR_FIELD_GUESS_CAP=25
# Maximum output tokens for one field-guess model call.
# CURATOR_FIELD_GUESS_MAX_TOKENS=2000
# max_tokens cap for the home synthesis call (Fireworks-path emissions routinely
# exceed the Claude-tuned 4000 default).
# CURATOR_HOME_MAX_TOKENS=4000
# Reasoning control, sent as reasoning_effort (openai-compat only). Some
# Fireworks models (e.g. Kimi K2.6) think by default and bill it as completion
# tokens — set "none" for the curator's single-shot synthesis calls.
# CURATOR_REASONING_EFFORT=none
# Statuses that count as "active" (comma-separated)
# CURATOR_ACTIVE_STATUSES=open,in-progress
# How many recent meeting bodies to read into the home synthesis
# CURATOR_MEETING_READS=10
# How many recent note bodies to read into the home synthesis
# CURATOR_NOTE_READS=6
# Per-node body truncation cap (chars). Empty/null = unlimited (no truncation).
# CURATOR_BODY_CHAR_CAP=
# Results requested from the engine's web-search per topic refresh.
# CURATOR_WEB_SEARCH_RESULTS=5
# How many of those results get fetched in full (fetch-url) for deeper text.
# CURATOR_WEB_FETCH_TOP=3
# Per-source truncation of fetched web text (chars).
# CURATOR_WEB_FETCH_CHAR_CAP=4000
# Default refresh cadence for vault+web wikis (per-wiki overridable via
# create-or-update-wiki's `cadence`). Format: <int><unit>, unit m|h|d|w.
# CURATOR_TOPIC_WEB_CADENCE=7d
# Semantic gap-fill: surface related-but-unlinked nodes as low-confidence leads
# in the home synthesis. Only the exact string "false" disables it.
# CURATOR_SEMANTIC_GAP_FILL=true
# Max gap-fill candidates surfaced per project (after dedup against linked nodes)
# CURATOR_SEMANTIC_GAP_FILL_LIMIT=15
# How many top candidates get a bounded body read (rest are title/type/status only)
# CURATOR_SEMANTIC_GAP_FILL_BODY_READS=3
# Auto-set a project's status to backlog when its wiki is older than this many days.
# CURATOR_STALE_PROJECT_DAYS=14
# CURATOR_STALE_PROJECT_STATUS=backlog
# Statuses that are never auto-backlogged (csv).
# CURATOR_STALE_SKIP_STATUSES=backlog,done,dropped
# The project node field holding status.
# CURATOR_PROJECT_STATUS_FIELD=status
# IANA timezone for the daily sweep (empty = system local zone). Takes effect
# after the NEXT sweep completes or on curator restart.
# CURATOR_TZ=America/New_York
# Local wall-clock time of the daily sweep, HH:MM 24h (DST-correct). Same
# re-arm-after-next-run timing as CURATOR_TZ.
# CURATOR_SWEEP_AT=05:00
# The curator persists durable facts it learns during synthesis as node-scoped
# memories (source=curator). Set to "false" to disable all curator memory writes.
# CURATOR_MEMORY_WRITE_ENABLED=true
# Max memories the curator may persist per curation run.
# CURATOR_MEMORY_WRITE_CAP=3
# Automatic memory collection (v1.6). Master switch — OPT-IN (default false);
# enable only after inspecting a --dry-run.
# CURATOR_MEMORY_SWEEP_ENABLED=false
# Allowlist: node types and/or path prefixes to sweep (CSV). Both empty = sweep inert.
# CURATOR_MEMORY_SWEEP_TYPES=
# CURATOR_MEMORY_SWEEP_PATHS=
# Per-run cap on persisted facts (note-granular: an over-cap note defers whole to next run).
# CURATOR_MEMORY_SWEEP_CAP=10
# Max facts extracted per note.
# CURATOR_MEMORY_SWEEP_NOTE_CAP=3
# max_tokens per extraction call. Reasoning models (deepseek-class) spend thinking
# tokens before the tool call — too low truncates extraction.
# CURATOR_MEMORY_SWEEP_MAX_TOKENS=4000
# Extraction model override — a Settings/Models/ catalog reference; empty = use
# the home model.
# CURATOR_MEMORY_SWEEP_MODEL=
# Conversation memory sweep. Master switch — OPT-IN: enable only after
# inspecting a dry run. Extracts durable user-asserted facts from settled
# VEfO conversations.
# CURATOR_CONVERSATION_SWEEP_ENABLED=false
# A conversation is swept only once untouched this many hours. Also the
# watermark lag.
# CURATOR_CONVERSATION_SWEEP_SETTLE_HOURS=6
# Prose floor: conversations with less USER text than this are ledgered and
# skipped with no LLM call.
# CURATOR_CONVERSATION_SWEEP_MIN_USER_CHARS=300
# Per-run cap on persisted facts (conversation-granular: an over-cap
# conversation defers whole to the next run).
# CURATOR_CONVERSATION_SWEEP_CAP=5
# Max facts extracted per conversation.
# CURATOR_CONVERSATION_SWEEP_PER_CONVERSATION_CAP=2
# max_tokens per extraction call. Reasoning models spend thinking tokens
# before the tool call — too low truncates extraction.
# CURATOR_CONVERSATION_SWEEP_MAX_TOKENS=4000
# Extraction model override — a Settings/Models/ catalog reference; empty =
# use the home model.
# CURATOR_CONVERSATION_SWEEP_MODEL=
# Organization sweep (misfiled + untyped nodes). Master switch — OPT-IN: enable
# only after inspecting a dry run.
# CURATOR_ORG_SWEEP_ENABLED=false
# CSV of path prefixes eligible for LLM typing. Blank/unset = the whole vault.
# CURATOR_ORG_TYPE_PATHS=
# CSV of exact directories eligible for moves ('/' = vault root, non-recursive).
# CURATOR_ORG_MOVE_PATHS=/
# CSV of exact file paths never moved.
# CURATOR_ORG_MOVE_PIN=CLAUDE.md
# CSV of type names the classifier may never assign — removed from its enum
# entirely (machinery-owned types like curator wiki pages, engine transcripts).
# CURATOR_ORG_TYPE_EXCLUDE=wiki,transcript
# Max LLM classification calls per run (cost bound for the untyped backlog drain).
# CURATOR_ORG_TYPE_CAP=25
# Max file moves per run.
# CURATOR_ORG_MOVE_CAP=25
# max_tokens per classification call (reasoning models need headroom).
# CURATOR_ORG_SWEEP_MAX_TOKENS=4000
# Classification model override — a Settings/Models/ catalog reference; empty =
# use the home model.
# CURATOR_ORG_SWEEP_MODEL=
# Curator Journal — write a narrative action-log entry to the vault after every
# run (Wikis/Curator Journal — YYYY-MM). "false" disables the vault note; events
# still land in the curator DB.
# CURATOR_JOURNAL_ENABLED=
# Journal lede model override — a Settings/Models/ catalog reference; empty =
# use the home model.
# CURATOR_JOURNAL_MODEL=
